# Data and generated artifacts. The split CSVs are the exception: they are small and
# committing them is what lets anyone reproduce the exact evaluation set.
# Note the `data/*` form -- git does not descend into an excluded *directory*, so
# `data/` followed by a negation would not work.
data/*
!data/splits/
artifacts/
mlruns/
outputs/
.cache/
*.onnx
*.pt
*.pth
*.npy
!tests/fixtures/*.npy

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.eggs/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
